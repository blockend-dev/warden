{
  "name": "@warden/devnet-deploy-script",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real end-to-end validation: deploys warden.compact to the local Docker devnet (infra/devnet/standalone.yml) and submits real proof-bearing transactions. See docs/IMPLEMENTATION-NOTES.md for why this is separate from packages/sdk's LocalSimulatorNetwork rather than a replacement for it.",
  "scripts": {
    "start": "node --experimental-strip-types src/deploy-and-call.ts"
  },
  "dependencies": {
    "@warden/contracts": "*",
    "@midnight-ntwrk/compact-js": "2.5.5-rc.8",
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.2"
  }
}
