// Compiled here with Compact 0.31.1 rather than the 0.34.0 packages/contracts
// uses, specifically so the generated circuit API matches the
// compact-runtime version the *stable* midnight-js@4.1.1 line's dependency
// chain actually ships with (see docs/IMPLEMENTATION-NOTES.md, "Live
// devnet"). This is otherwise the exact same source as
// packages/contracts/src/warden.compact — including the blockTimeLte
// expiry fix — confirmed to compile identically under 0.31.1; nothing here
// is a stripped-down or outdated copy.

pragma language_version >= 0.20;

import CompactStandardLibrary;

// Private except `expiry`, which blockTimeLte requires to be public.
struct Policy {
  maxAmount: Uint<64>;
  asset: Bytes<32>;
  actionType: Bytes<32>;
  destinationCategory: Bytes<32>;
  expiry: Uint<64>;
  actionCountLimit: Uint<16>;
  salt: Bytes<32>; // must be fresh per mandate; never reuse
}

// Private bundle behind a public mandate id. Handed to the agent out of band.
struct MandateContext {
  principalPk: Bytes<32>;
  agentPk: Bytes<32>;
  policy: Policy;
}

// Keyed by mandate id, never by principal/agent identity.
export ledger registered: Set<Bytes<32>>;
export ledger revoked: Set<Bytes<32>>;
export ledger spentCommitment: Map<Bytes<32>, Bytes<32>>;
export ledger actionCount: Map<Bytes<32>, Counter>;

// Witness output is untrusted; every value is re-verified below.
witness principalSecret(id: Bytes<32>): Bytes<32>;
witness agentSecret(id: Bytes<32>): Bytes<32>;
witness mandateContextOf(id: Bytes<32>): MandateContext;
witness spentSoFar(id: Bytes<32>): Uint<64>;
witness spentNonce(id: Bytes<32>): Bytes<32>;
witness freshNonce(id: Bytes<32>): Bytes<32>;

// Domain-separated via string prefixes. Exported so the SDK can derive
// these client-side using the same implementation the circuits check against.
export pure circuit pkOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "warden:pk:"), secret]);
}

pure circuit policyHash(policy: Policy): Bytes<32> {
  return persistentHash<Vector<8, Bytes<32>>>([
    pad(32, "warden:policy:"),
    policy.maxAmount as Field as Bytes<32>,
    policy.asset,
    policy.actionType,
    policy.destinationCategory,
    policy.expiry as Field as Bytes<32>,
    policy.actionCountLimit as Field as Bytes<32>,
    policy.salt
  ]);
}

export pure circuit mandateId(ctx: MandateContext): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "warden:mandate:"),
    ctx.principalPk,
    ctx.agentPk,
    policyHash(ctx.policy)
  ]);
}

// Re-randomized on every update so on-chain values are unlinkable.
export pure circuit spendCommitment(total: Uint<64>, nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "warden:spent:"),
    total as Field as Bytes<32>,
    nonce
  ]);
}

// Registers a new mandate under its commitment id.
export circuit createMandate(id: Bytes<32>): [] {
  const pid = disclose(id);
  assert(!registered.member(pid), "mandate already exists");

  const ctx = mandateContextOf(pid);
  assert(mandateId(ctx) == pid, "mandate context does not match its public id");
  assert(pkOf(principalSecret(pid)) == ctx.principalPk, "caller is not the principal for this mandate");
  assert(ctx.policy.actionCountLimit > 0, "action count limit must be positive");
  assert(blockTimeLte(disclose(ctx.policy.expiry)), "expiry must be in the future");

  registered.insert(pid);
  actionCount.insert(pid, default<Counter>);

  const initNonce = freshNonce(pid);
  const initCommit = disclose(spendCommitment(0, initNonce));
  spentCommitment.insert(pid, initCommit);
}

// Authorizes an action and advances the spend commitment.
export circuit authorize(
  id: Bytes<32>,
  requestedAmount: Uint<64>,
  requestedAsset: Bytes<32>,
  requestedActionType: Bytes<32>,
  requestedDestinationCategory: Bytes<32>
): [] {
  const pid = disclose(id);
  assert(registered.member(pid), "unknown mandate");
  assert(!revoked.member(pid), "mandate revoked");

  const ctx = mandateContextOf(pid);
  assert(mandateId(ctx) == pid, "mandate context does not match its public id");
  assert(pkOf(agentSecret(pid)) == ctx.agentPk, "caller is not the authorized agent for this mandate");

  assert(blockTimeLte(disclose(ctx.policy.expiry)), "mandate expired");
  assert(requestedAsset == ctx.policy.asset, "asset not permitted by mandate");
  assert(requestedActionType == ctx.policy.actionType, "action type not permitted by mandate");
  assert(requestedDestinationCategory == ctx.policy.destinationCategory, "destination not permitted by mandate");

  const priorCount = actionCount.lookup(pid).read();
  assert(priorCount < ctx.policy.actionCountLimit as Uint<64>, "action count limit reached");

  const priorSpent = spentSoFar(pid);
  const priorNonce = spentNonce(pid);
  assert(
    spentCommitment.lookup(pid) == spendCommitment(priorSpent, priorNonce),
    "stale or forged spend state"
  );
  const newTotal = priorSpent + requestedAmount;
  assert(newTotal <= ctx.policy.maxAmount, "policy violation: amount exceeds mandate cap");

  const fresh = freshNonce(pid);
  const newCommit = disclose(spendCommitment(newTotal as Uint<64>, fresh));
  spentCommitment.insert(pid, newCommit);
  actionCount.lookup(pid).increment(1);
}

// Permanently revokes a mandate.
export circuit revoke(id: Bytes<32>): [] {
  const pid = disclose(id);
  assert(registered.member(pid), "unknown mandate");
  assert(!revoked.member(pid), "mandate already revoked");

  const ctx = mandateContextOf(pid);
  assert(mandateId(ctx) == pid, "mandate context does not match its public id");
  assert(pkOf(principalSecret(pid)) == ctx.principalPk, "caller is not the principal for this mandate");

  revoked.insert(pid);
}
