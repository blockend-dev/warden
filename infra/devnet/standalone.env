# Dev-only defaults for the local standalone indexer container — not
# secrets in any meaningful sense (they never leave this machine, and this
# is an `undeployed` local network with no real value on it). Verbatim from
# `midnightntwrk/example-counter`'s `standalone.env.example`, plus one
# addition below for indexer-standalone 4.3.7+.
APP__INFRA__NODE__URL=ws://node:9944
APP__INFRA__STORAGE__PASSWORD=indexer
APP__INFRA__PUB_SUB__PASSWORD=indexer
APP__INFRA__LEDGER_STATE_STORAGE__PASSWORD=indexer
APP__INFRA__SECRET=303132333435363738393031323334353637383930313233343536373839303132
# New in 4.3.7 (not in example-counter's still-4.0.0-pinned example): the
# spo-indexer's Blockfrost API key for Cardano stake-distribution queries.
# Not exercised by anything in this repo — any non-empty placeholder is
# accepted at startup per midnight-indexer's own config docs.
APP__INFRA__SPO_NODE__BLOCKFROST_ID=dummy-not-using-spo
