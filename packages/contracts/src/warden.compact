// Warden — privacy-preserving authorization protocol for autonomous agents.
//
// A principal grants an agent a mandate: a private policy (spending cap, asset,
// action type, destination category, expiry, action-count limit). Only a
// domain-separated commitment to that policy — the "mandate id" — is public.
// An agent can `authorize` an action only by proving, in zero knowledge, that
// it holds the private mandate context behind that public id and that the
// requested action satisfies every clause of the policy. The principal (and
// only the principal — proven the same way) can `revoke` a mandate; every
// later `authorize` against a revoked id is rejected by the circuit itself,
// not by application-layer discretion.
//
// See docs/ARCHITECTURE.md for the full design and docs/PRIVACY.md for the
// exact public/private/derived classification of every field below.

pragma language_version >= 0.20;

import CompactStandardLibrary;

// The mandate's terms. Never touches the ledger and no exported circuit
// returns the struct itself — only `mandateId(...)`, a one-way commitment to
// it, is public by default. `expiry` is the one field that is additionally
// disclosed on its own: enforcing it against real time requires the standard
// library's `blockTimeLte`, whose argument the compiler requires to be
// public (see `createMandate` and `authorize`, and docs/PRIVACY.md). Every
// other field stays private.
struct Policy {
  maxAmount: Uint<64>;
  asset: Bytes<32>;
  actionType: Bytes<32>;
  destinationCategory: Bytes<32>;
  expiry: Uint<64>;
  actionCountLimit: Uint<16>;
  // Freshness for the mandate commitment. Must be sampled uniformly at random
  // per mandate and never reused — see docs/THREAT-MODEL.md, "randomness reuse".
  salt: Bytes<32>;
}

// The full private bundle behind a public mandate id: the policy plus the
// principal's and agent's key-commitments. Handed by the principal to the
// agent out of band at mandate-creation time (see docs/ARCHITECTURE.md,
// "capability handoff") — the contract itself never transmits it.
struct MandateContext {
  principalPk: Bytes<32>;
  agentPk: Bytes<32>;
  policy: Policy;
}

// -- Public ledger state -----------------------------------------------------
// registered / revoked / actionCount are commitment-keyed: every entry is
// addressed by a mandate id (a hash), never by a principal or agent identity.
// spentCommitment is an *opaque* running-total commitment, not a plaintext
// amount — see docs/PRIVACY.md for exactly what this does and does not leak.

export ledger registered: Set<Bytes<32>>;
export ledger revoked: Set<Bytes<32>>;
export ledger spentCommitment: Map<Bytes<32>, Bytes<32>>;
export ledger actionCount: Map<Bytes<32>, Counter>;

// -- Witnesses (private, TypeScript-side, untrusted by the circuit) ---------
// Every value these return is re-verified inside the circuits below before it
// is relied on for anything security-relevant. See docs/THREAT-MODEL.md.

witness principalSecret(id: Bytes<32>): Bytes<32>;
witness agentSecret(id: Bytes<32>): Bytes<32>;
witness mandateContextOf(id: Bytes<32>): MandateContext;
witness spentSoFar(id: Bytes<32>): Uint<64>;
witness spentNonce(id: Bytes<32>): Bytes<32>;
witness freshNonce(id: Bytes<32>): Bytes<32>;

// -- Pure helpers (no ledger access, no witness calls) -----------------------

// `pkOf`, `mandateId`, and `spendCommitment` are exported pure circuits so
// the SDK can derive key-commitments and spend commitments client-side using
// the exact same, compiler-verified implementation the circuits below check
// against — never a hand-reimplemented hash that could silently drift from it.
export pure circuit pkOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "warden:pk:"), secret]);
}

pure circuit policyHash(policy: Policy): Bytes<32> {
  return persistentHash<Vector<8, Bytes<32>>>([
    pad(32, "warden:policy:"),
    policy.maxAmount as Field as Bytes<32>,
    policy.asset,
    policy.actionType,
    policy.destinationCategory,
    policy.expiry as Field as Bytes<32>,
    policy.actionCountLimit as Field as Bytes<32>,
    policy.salt
  ]);
}

// The mandate id: a domain-separated commitment binding the principal, the
// agent, and every policy clause together.
export pure circuit mandateId(ctx: MandateContext): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "warden:mandate:"),
    ctx.principalPk,
    ctx.agentPk,
    policyHash(ctx.policy)
  ]);
}

// An opaque commitment to a running spend total. Chained with a fresh nonce
// on every update so consecutive on-chain values are unlinkable — an observer
// sees that *a* mandate's spend state changed, never by how much, and never
// the mandate's cap. See docs/PRIVACY.md, "spend commitment chaining".
export pure circuit spendCommitment(total: Uint<64>, nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "warden:spent:"),
    total as Field as Bytes<32>,
    nonce
  ]);
}

// -- Protocol circuits --------------------------------------------------------

// Registers a new mandate. Callable only by whoever holds the private
// MandateContext behind `id` *and* can prove they are its principal (not its
// agent — see `pkOf(principalSecret(...))`), so an id alone is never enough
// to create or claim a mandate.
export circuit createMandate(id: Bytes<32>): [] {
  const pid = disclose(id);
  assert(!registered.member(pid), "mandate already exists");

  const ctx = mandateContextOf(pid);
  assert(mandateId(ctx) == pid, "mandate context does not match its public id");
  assert(pkOf(principalSecret(pid)) == ctx.principalPk, "caller is not the principal for this mandate");
  assert(ctx.policy.actionCountLimit > 0, "action count limit must be positive");
  assert(blockTimeLte(disclose(ctx.policy.expiry)), "expiry must be in the future");

  registered.insert(pid);
  actionCount.insert(pid, default<Counter>);

  const initNonce = freshNonce(pid);
  const initCommit = disclose(spendCommitment(0, initNonce));
  spentCommitment.insert(pid, initCommit);
}

// The enforcement circuit. Succeeds only if the caller holds the mandate
// context, is its registered agent, the mandate is neither expired nor
// revoked, the requested action matches every policy clause, the action-count
// limit is not exhausted, and the new cumulative spend still fits the cap.
// Every one of those is a circuit-level `assert`, not a UI check — a proof
// simply cannot be constructed if any of them is false.
export circuit authorize(
  id: Bytes<32>,
  requestedAmount: Uint<64>,
  requestedAsset: Bytes<32>,
  requestedActionType: Bytes<32>,
  requestedDestinationCategory: Bytes<32>
): [] {
  const pid = disclose(id);
  assert(registered.member(pid), "unknown mandate");
  assert(!revoked.member(pid), "mandate revoked");

  const ctx = mandateContextOf(pid);
  assert(mandateId(ctx) == pid, "mandate context does not match its public id");
  assert(pkOf(agentSecret(pid)) == ctx.agentPk, "caller is not the authorized agent for this mandate");

  assert(blockTimeLte(disclose(ctx.policy.expiry)), "mandate expired");
  assert(requestedAsset == ctx.policy.asset, "asset not permitted by mandate");
  assert(requestedActionType == ctx.policy.actionType, "action type not permitted by mandate");
  assert(requestedDestinationCategory == ctx.policy.destinationCategory, "destination not permitted by mandate");

  const priorCount = actionCount.lookup(pid).read();
  assert(priorCount < ctx.policy.actionCountLimit as Uint<64>, "action count limit reached");

  const priorSpent = spentSoFar(pid);
  const priorNonce = spentNonce(pid);
  assert(
    spentCommitment.lookup(pid) == spendCommitment(priorSpent, priorNonce),
    "stale or forged spend state"
  );
  const newTotal = priorSpent + requestedAmount;
  assert(newTotal <= ctx.policy.maxAmount, "policy violation: amount exceeds mandate cap");

  const fresh = freshNonce(pid);
  const newCommit = disclose(spendCommitment(newTotal as Uint<64>, fresh));
  spentCommitment.insert(pid, newCommit);
  actionCount.lookup(pid).increment(1);
}

// Revocation. Gated on the *principal's* secret specifically (never the
// agent's) — see the `pkOf(principalSecret(...))` assertion, which is the
// entire access-control mechanism here. Once `revoked` contains `pid`, no
// future `authorize` call against it can ever succeed again: there is no
// "un-revoke" circuit, by design (see docs/THREAT-MODEL.md).
export circuit revoke(id: Bytes<32>): [] {
  const pid = disclose(id);
  assert(registered.member(pid), "unknown mandate");
  assert(!revoked.member(pid), "mandate already revoked");

  const ctx = mandateContextOf(pid);
  assert(mandateId(ctx) == pid, "mandate context does not match its public id");
  assert(pkOf(principalSecret(pid)) == ctx.principalPk, "caller is not the principal for this mandate");

  revoked.insert(pid);
}
