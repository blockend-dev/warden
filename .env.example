# apps/web — live Midnight Preprod backend configuration.
#
# Copy the values you need into Railway's service variables (never into a
# committed .env file — this file holds placeholders only). Omitting
# WARDEN_NETWORK, or setting it to anything other than "preprod", runs
# apps/web against LocalSimulatorNetwork exactly as before — no live network,
# no credentials needed. See docs/DEPLOY-RAILWAY.md for the full deployment
# procedure and docs/IMPLEMENTATION-NOTES.md for why two differently
# -compiled contracts exist.

# Set to "preprod" to run the hosted app against the real Midnight Preprod
# network. Any other value (or unset) — the default for local dev — uses
# the in-process simulator.
WARDEN_NETWORK=simulator

# --- Required when WARDEN_NETWORK=preprod ---

# The server-side wallet's 32-byte hex seed. This pays transaction fees and
# submits every live call on the hosted app's behalf — SECRET, server-side
# only, never a NEXT_PUBLIC_* variable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then fund the resulting address via the public Preprod faucet — see
# infra/devnet/deploy-script-legacy/src/print-preprod-address.ts to derive
# the address from a seed without running the whole deploy script.
WARDEN_PREPROD_SEED=

# The already-deployed Warden contract's address on Preprod. Not a secret,
# but wrong values here silently point the app at nothing (or someone
# else's contract) — set explicitly, never accepted from the browser. The
# proven deployment from this repository's own validation run:
#   a61fb3417a82f6eff61e98e3ac50e759d916a86636f9ec25b9551375be8162bb
WARDEN_CONTRACT_ADDRESS=

# --- Optional when WARDEN_NETWORK=preprod (sensible defaults built in) ---

# Real public Midnight Preprod endpoints — override only if Midnight
# publishes new ones; do not point these at an untrusted endpoint (the app
# never accepts these from a request, only from server config).
# WARDEN_PREPROD_INDEXER=https://indexer.preprod.midnight.network/api/v4/graphql
# WARDEN_PREPROD_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# WARDEN_PREPROD_NODE=https://rpc.preprod.midnight.network

# The proof server handles private witness data and must run somewhere this
# app's server can reach privately — never the public internet, never the
# browser. On Railway this is a second service (the public
# midnightntwrk/proof-server:8.0.3 image) reached over Railway's private
# network — see docs/DEPLOY-RAILWAY.md for the exact setup.
# WARDEN_PROOF_SERVER_URL=http://127.0.0.1:6300
