node_modules/
dist/
.next/
*.tsbuildinfo
.env
.env.local
.DS_Store
npm-debug.log*

# Compact compiler output — regenerated by `npm run compact` (see
# packages/contracts/package.json). Proving/verifying keys and zkir are
# build artifacts, not source; keeping them out of git keeps the repo small
# and avoids stale artifacts drifting from warden.compact.
packages/contracts/src/managed/

# Same reasoning for the live-devnet validation scripts under infra/devnet —
# see docs/DEPLOYMENT.md. The legacy variant is compiled with an
# intentionally older compiler (0.31.1); regenerate via
# `compact compile --directory ~/.compact src/warden.compact <out> +0.31.1`.
infra/devnet/deploy-script-legacy/contract/src/managed/

# apps/web's own copy of the same 0.31.1-compiled artifacts, for its live
# Preprod backend — regenerate via `npm run compact:legacy --workspace apps/web`.
apps/web/src/server/preprod/contract/managed/

# Server-side wallet sync/checkpoint state for apps/web's live Preprod
# connection — never secrets by itself, but never something to commit;
# reused across restarts only via a mounted Railway volume, not git.
apps/web/midnight-level-db/
apps/web/.preprod-seed

# Wallet/private-state storage the deploy scripts create when run (LevelDB
# stores, transaction logs) — local, per-run state, never secrets meant to be
# shared, but also never something to commit.
infra/devnet/**/logs/
infra/devnet/**/*.leveldb/
infra/devnet/**/private-state-store*/
infra/devnet/**/midnight-level-db/

# A real (if testnet-only) wallet seed — never committed, even for Preprod.
infra/devnet/**/.preprod-seed
