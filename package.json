{
  "name": "warden",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra/devnet/deploy-script",
    "infra/devnet/deploy-script-legacy"
  ],
  "scripts": {
    "compact": "npm run compact --workspace packages/contracts",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.1",
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/midnight-js-protocol": {
      "@midnight-ntwrk/onchain-runtime-v3": "3.1.1",
      "@midnight-ntwrk/ledger-v8": "8.1.2"
    }
  }
}
